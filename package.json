{
  "name": "elysia-idempotency",
  "version": "0.1.0",
  "description": "Idempotency-Key plugin for Elysia: a retried request returns the original response instead of running the handler again.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "elysia",
    "bun",
    "idempotency",
    "idempotency-key",
    "retry",
    "payments",
    "redis",
    "zod"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "pack:check": "bun pm pack --dry-run",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "elysia": "^1.4.30",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "elysia": "^1.4.30",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
